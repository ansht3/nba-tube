# Optional. Without a key, "npm run sync" uses the channels' public upload
# feeds instead (15 newest uploads per channel, no durations).
# See docs/YOUTUBE_SETUP.md. Never commit the real .env file.
YOUTUBE_API_KEY=

# Optional. Only for hosts that serve the site from a sub-path, such as a
# GitHub Pages project site ("/nba-tube"). Leave empty for local use.
NEXT_PUBLIC_BASE_PATH=
